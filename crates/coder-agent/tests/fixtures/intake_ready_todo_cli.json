        "path": "src/main.rs",
        "must_include": ["fn main"]
      },
      {
        "type": "git_nonempty_diff",
        "id": "has_diff"
      }
    ],
    "out_of_scope": ["network access", "GUI", "database server"],
    "assumed_defaults": ["Rust binary crate", "local file store"],
    "domain_hint": "coding",
    "verify_profile": null
