{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "reviewed_sha", "summary", "findings"],
  "properties": {
    "schema": { "const": "liberado.pr-review.v1" },
    "reviewed_sha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "summary": { "type": "string", "minLength": 1 },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "blocker", "path", "line", "explanation", "check"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["low", "medium", "high", "critical"] },
          "blocker": { "type": "boolean" },
          "path": { "type": "string", "minLength": 1 },
          "line": { "type": ["integer", "null"], "minimum": 1 },
          "explanation": { "type": "string", "minLength": 1 },
          "check": { "type": ["string", "null"] }
        }
      }
    }
  }
}
